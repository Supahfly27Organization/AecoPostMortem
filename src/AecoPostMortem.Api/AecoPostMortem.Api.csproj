<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Code review Minor (both reviews): AecoPostMortem.Api.Tests needs a deterministic, host-
         timezone-independent way to test ApiHost.ParseTimestampAsUtc's own UTC-assumption fix —
         asserting through the full GetDigest/HTTP path would make the test's own pass/fail depend
         on the CI machine's ambient local offset, exactly the non-determinism PRD §3.8 exists to
         rule out. -->
    <InternalsVisibleTo Include="AecoPostMortem.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AecoPostMortem.Data\AecoPostMortem.Data.csproj" />
    <ProjectReference Include="..\AecoPostMortem.Findings\AecoPostMortem.Findings.csproj" />
    <ProjectReference Include="..\AecoPostMortem.Ingestion\AecoPostMortem.Ingestion.csproj" />
    <!-- S-22 (FR-40): RulesInventoryEnvelope maps AecoPostMortem.Rules' own inventory shapes.
         Stated explicitly rather than leaned on transitively through Findings, so this project's
         own dependency list says what its source actually names. -->
    <ProjectReference Include="..\AecoPostMortem.Rules\AecoPostMortem.Rules.csproj" />
  </ItemGroup>

</Project>
